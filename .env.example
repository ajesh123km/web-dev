# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Optional - for remote database persistence)
# The server will automatically persist to Supabase if configured,
# and gracefully use server-side JSON storage if not yet configured.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# RESEND EMAIL CONFIGURATION (Optional - for sending automated emails)
# Notification recipient: ajesh321km2@gmail.com
RESEND_API_KEY="re_123456789"
RESEND_FROM_EMAIL="onboarding@resend.dev"

# ADMIN AUTHENTICATION
ADMIN_SECRET_KEY="teamstars-admin-secure-key"
ADMIN_PASSWORD="teamstars2025"

